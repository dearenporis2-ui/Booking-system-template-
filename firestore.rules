rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ADMIN ALLOWLIST ===================================================
    // List every email that should have dashboard access — it MUST match
    // BRAND.adminEmails in admin/index.html. Use lowercase.
    // These rules are the real security boundary: Google sign-in lets ANY Google
    // account authenticate, so "request.auth != null" alone would NOT be safe.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'you@example.com'
          // , 'employee@example.com'
        ];
    }

    // Services shown to clients — public read, admin manages
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business hours + booking rules — public read, admin manages
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Holidays / days off — public read, admin manages
    match /blockedDates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Grid slots that power double-booking prevention.
    // Public can read (to see availability) and create (to book) — but never
    // update or delete. Cancelling an appointment (admin) deletes its slots.
    match /slots/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Appointment records contain client contact details — clients can create
    // their own booking, but only an admin can read the list or change/cancel.
    match /appointments/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
